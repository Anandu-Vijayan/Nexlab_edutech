# Google Apps Script Web App URL (server-only — not exposed to the browser)
# https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_WEB_APP_URL=

# Optional: shared secret sent to Apps Script (set same value in Script Properties)
REGISTRATION_API_SECRET=

# Rate limit for POST /api/register (in-memory; resets on server restart)
# Default: 5 requests per 24 hours per IP
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=86400000
